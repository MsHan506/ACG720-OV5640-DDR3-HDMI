    .D9(\tmds_internal[2] [9]),
    .PCLK(clk_vga),
    .FCLK(clk_vgax5),
    .RESET(GND) 
);
  OSER10 u_clock_oser10 (
    .Q(tmds_clock_single),
    .D0(VCC),
