module camera_pll (
  clk50M_d,
  hdmi_pll_lock,
  clk_vgax5,
  camera_xclk_d
)
;
input clk50M_d;
output hdmi_pll_lock;
output clk_vgax5;
output camera_xclk_d;
wire clkout2_unused;
wire clkout3_unused;
wire clkout4_unused;
wire clkout5_unused;
wire clkout6_unused;
wire clkfbout_unused;
wire [7:0] MDRDO;
wire VCC;
wire GND;
  PLLA pll_inst (
    .MDRDO(MDRDO[7:0]),
    .LOCK(hdmi_pll_lock),
    .CLKOUT0(clk_vgax5),
    .CLKOUT1(camera_xclk_d),
    .CLKOUT2(clkout2_unused),
    .CLKOUT3(clkout3_unused),
    .CLKOUT4(clkout4_unused),
    .CLKOUT5(clkout5_unused),
    .CLKOUT6(clkout6_unused),
    .CLKFBOUT(clkfbout_unused),
    .CLKIN(clk50M_d),
    .CLKFB(GND),
    .RESET(GND),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}),
    .MDCLK(GND),
    .MDOPC({GND,GND}),
    .MDAINC(GND),
    .MDWDI({GND,GND,GND,GND,GND,GND,GND,GND}) 
);
defparam pll_inst.CLKFB_SEL="INTERNAL";
defparam pll_inst.CLKOUT0_EN="TRUE";
defparam pll_inst.CLKOUT1_EN="TRUE";
defparam pll_inst.CLKOUT2_EN="FALSE";
defparam pll_inst.CLKOUT3_EN="FALSE";
defparam pll_inst.CLKOUT4_EN="FALSE";
defparam pll_inst.CLKOUT5_EN="FALSE";
defparam pll_inst.CLKOUT6_EN="FALSE";
defparam pll_inst.FBDIV_SEL=1;
defparam pll_inst.FCLKIN="50";
defparam pll_inst.IDIV_SEL=2;
defparam pll_inst.MDIV_FRAC_SEL=1;
defparam pll_inst.MDIV_SEL=37;
defparam pll_inst.ODIV0_FRAC_SEL=4;
defparam pll_inst.ODIV0_SEL=2;
defparam pll_inst.ODIV1_SEL=37;
defparam pll_inst.ODIV2_SEL=8;
defparam pll_inst.ODIV3_SEL=8;
defparam pll_inst.ODIV4_SEL=8;
defparam pll_inst.ODIV5_SEL=8;
defparam pll_inst.ODIV6_SEL=8;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* camera_pll */
module Gowin_PLL (
  clk50M_d,
  n1035_6,
  ddr_mdrp_inc,
  ddr_mdrp_op,
  ddr_mdrp_wdata,
  loc_clk50m,
  clk_200M,
  ddr_mdrp_rdata,
  led_d
)
;
input clk50M_d;
input n1035_6;
input ddr_mdrp_inc;
input [1:0] ddr_mdrp_op;
input [7:0] ddr_mdrp_wdata;
output loc_clk50m;
output clk_200M;
output [6:0] ddr_mdrp_rdata;
output [0:0] led_d;
wire clkout0;
wire clkout3_unused;
wire clkout4_unused;
wire clkout5_unused;
wire clkout6_unused;
wire clkfbout_unused;
wire [7:7] MDRDO;
wire VCC;
wire GND;
  PLLA pll_inst (
    .MDRDO({MDRDO[7],ddr_mdrp_rdata[6:0]}),
    .LOCK(led_d[0]),
    .CLKOUT0(clkout0),
    .CLKOUT1(loc_clk50m),
    .CLKOUT2(clk_200M),
    .CLKOUT3(clkout3_unused),
    .CLKOUT4(clkout4_unused),
    .CLKOUT5(clkout5_unused),
    .CLKOUT6(clkout6_unused),
    .CLKFBOUT(clkfbout_unused),
    .CLKIN(clk50M_d),
    .CLKFB(GND),
    .RESET(n1035_6),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}),
    .MDCLK(clk50M_d),
    .MDOPC(ddr_mdrp_op[1:0]),
    .MDAINC(ddr_mdrp_inc),
    .MDWDI(ddr_mdrp_wdata[7:0]) 
);
defparam pll_inst.CLKFB_SEL="INTERNAL";
defparam pll_inst.CLKOUT0_EN="FALSE";
defparam pll_inst.CLKOUT1_EN="TRUE";
defparam pll_inst.CLKOUT2_EN="TRUE";
defparam pll_inst.CLKOUT3_EN="FALSE";
defparam pll_inst.CLKOUT4_EN="FALSE";
defparam pll_inst.CLKOUT5_EN="FALSE";
defparam pll_inst.CLKOUT6_EN="FALSE";
defparam pll_inst.FBDIV_SEL=1;
defparam pll_inst.FCLKIN="50";
defparam pll_inst.IDIV_SEL=1;
defparam pll_inst.MDIV_FRAC_SEL=0;
defparam pll_inst.MDIV_SEL=16;
defparam pll_inst.ODIV0_FRAC_SEL=0;
defparam pll_inst.ODIV0_SEL=4;
defparam pll_inst.ODIV1_SEL=16;
defparam pll_inst.ODIV2_SEL=4;
defparam pll_inst.ODIV3_SEL=8;
defparam pll_inst.ODIV4_SEL=8;
defparam pll_inst.ODIV5_SEL=8;
defparam pll_inst.ODIV6_SEL=8;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
