module rk3588_custom_dvi_link_test_top (
  clk50M,
  reset_n,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n,
  led
)
;
input clk50M;
input reset_n;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
output [3:0] led;
wire clk50M_d;
wire reset_n_d;
wire tx_enable;
wire pll_drop_seen;
wire pll_locked;
wire [2:2] led_d;
wire VCC;
wire GND;
  IBUF clk50M_ibuf (
    .O(clk50M_d),
    .I(clk50M) 
);
  IBUF reset_n_ibuf (
    .O(reset_n_d),
    .I(reset_n) 
);
  OBUF led_0_obuf (
    .O(led[0]),
    .I(pll_locked) 
);
  OBUF led_1_obuf (
    .O(led[1]),
    .I(tx_enable) 
);
  OBUF led_2_obuf (
    .O(led[2]),
    .I(led_d[2]) 
);
  OBUF led_3_obuf (
    .O(led[3]),
    .I(pll_drop_seen) 
);
  rk3588_hdmi_link_test_top u_test (
    .clk50M_d(clk50M_d),
    .reset_n_d(reset_n_d),
    .tx_enable(tx_enable),
    .pll_drop_seen(pll_drop_seen),
    .pll_locked(pll_locked),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0]),
    .led_d(led_d[2])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* rk3588_custom_dvi_link_test_top */
