module serializer (
  clk_vga,
  clk_vgax5,
  \tmds_internal[0] ,
  \tmds_internal[1] ,
  \tmds_internal[2] ,
  tmds_clock_single,
  tmds_single
)
;
input clk_vga;
input clk_vgax5;
input [9:0] \tmds_internal[0] ;
input [9:0] \tmds_internal[1] ;
input [9:0] \tmds_internal[2] ;
output tmds_clock_single;
output [2:0] tmds_single;
wire VCC;
wire GND;
  OSER10 \g_oser10[0].u_oser10  (
    .Q(tmds_single[0]),
    .D0(\tmds_internal[0] [0]),
    .D1(\tmds_internal[0] [1]),
    .D2(\tmds_internal[0] [2]),
    .D3(\tmds_internal[0] [3]),
    .D4(\tmds_internal[0] [4]),
    .D5(\tmds_internal[0] [5]),
    .D6(\tmds_internal[0] [6]),
    .D7(\tmds_internal[0] [7]),
    .D8(\tmds_internal[0] [8]),
    .D9(\tmds_internal[0] [9]),
