    .D9(\tmds_internal[2] [9]),
    .PCLK(clk_vga),
    .FCLK(clk_vgax5),
    .RESET(GND) 
);
  OSER10 u_clock_oser10 (
    .Q(tmds_clock_single),
    .D0(GND),
    .D1(GND),
    .D2(GND),
    .D3(GND),
    .D4(GND),
    .D5(VCC),
    .D6(VCC),
    .D7(VCC),
    .D8(VCC),
