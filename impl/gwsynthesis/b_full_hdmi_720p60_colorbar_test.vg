module camera_pll (
  loc_clk50m,
  hdmi_pll_lock,
  clk_vgax5,
  camera_xclk_d
)
;
input loc_clk50m;
output hdmi_pll_lock;
output clk_vgax5;
output camera_xclk_d;
wire clkout2_unused;
wire clkout3_unused;
wire clkout4_unused;
wire clkout5_unused;
wire clkout6_unused;
wire clkfbout_unused;
wire [7:0] MDRDO;
wire VCC;
wire GND;
  PLLA pll_inst (
    .MDRDO(MDRDO[7:0]),
    .LOCK(hdmi_pll_lock),
    .CLKOUT0(clk_vgax5),
    .CLKOUT1(camera_xclk_d),
    .CLKOUT2(clkout2_unused),
    .CLKOUT3(clkout3_unused),
    .CLKOUT4(clkout4_unused),
    .CLKOUT5(clkout5_unused),
    .CLKOUT6(clkout6_unused),
    .CLKFBOUT(clkfbout_unused),
    .CLKIN(loc_clk50m),
    .CLKFB(GND),
    .RESET(GND),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}),
