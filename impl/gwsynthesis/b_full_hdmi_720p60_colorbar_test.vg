module DDR3_Memory_Interface_Top (
  app_en_Z,
  \state.READ ,
  app_wdf_end,
  loc_clk50m,
  clk_200M,
  reset_n_d,
  n9_6_3,
  app_addr_Z,
  app_wdf_data,
  led_d,
  app_rd_data_valid,
  full,
  app_wdf_rdy,
  ui_clk,
  n7_6_3,
  O_ddr_clk,
  O_ddr_clk_n,
  O_ddr_reset_n,
  O_ddr_cs_n,
  O_ddr_ras_n,
  O_ddr_cas_n,
  O_ddr_we_n,
  O_ddr_cke,
  O_ddr_odt,
  O_ddr_dqm,
  O_ddr_addr,
  O_ddr_ba,
  app_rd_data,
  led_d_10,
  IO_ddr_dqs,
  IO_ddr_dqs_n,
  IO_ddr_dq
)
;
input app_en_Z;
input \state.READ ;
input app_wdf_end;
input loc_clk50m;
input clk_200M;
input reset_n_d;
input n9_6_3;
input [24:3] app_addr_Z;
input [127:0] app_wdf_data;
input [0:0] led_d;
output app_rd_data_valid;
output full;
output app_wdf_rdy;
output ui_clk;
output n7_6_3;
output O_ddr_clk;
output O_ddr_clk_n;
output O_ddr_reset_n;
output O_ddr_cs_n;
output O_ddr_ras_n;
output O_ddr_cas_n;
output O_ddr_we_n;
output O_ddr_cke;
output O_ddr_odt;
output [1:0] O_ddr_dqm;
output [13:0] O_ddr_addr;
output [2:0] O_ddr_ba;
output [127:0] app_rd_data;
output [1:1] led_d_10;
inout [1:0] IO_ddr_dqs;
inout [1:0] IO_ddr_dqs_n;
inout [15:0] IO_ddr_dq;
wire VCC;
wire GND;
  \~GW_DDR3_PHY_MC.DDR3_Memory_Interface_Top  gw3_top (
    .app_en_Z(app_en_Z),
    .\state.READ (\state.READ ),
    .app_wdf_end(app_wdf_end),
    .loc_clk50m(loc_clk50m),
    .clk_200M(clk_200M),
    .reset_n_d(reset_n_d),
    .n9_6_3(n9_6_3),
    .app_addr_Z(app_addr_Z[24:3]),
    .app_wdf_data(app_wdf_data[127:0]),
    .led_d(led_d[0]),
    .app_rd_data_valid(app_rd_data_valid),
    .full(full),
    .app_wdf_rdy(app_wdf_rdy),
    .ui_clk(ui_clk),
    .n7_6_3(n7_6_3),
    .O_ddr_clk(O_ddr_clk),
    .O_ddr_clk_n(O_ddr_clk_n),
    .O_ddr_reset_n(O_ddr_reset_n),
    .O_ddr_cs_n(O_ddr_cs_n),
    .O_ddr_ras_n(O_ddr_ras_n),
    .O_ddr_cas_n(O_ddr_cas_n),
    .O_ddr_we_n(O_ddr_we_n),
    .O_ddr_cke(O_ddr_cke),
    .O_ddr_odt(O_ddr_odt),
    .O_ddr_dqm(O_ddr_dqm[1:0]),
    .O_ddr_addr(O_ddr_addr[13:0]),
    .O_ddr_ba(O_ddr_ba[2:0]),
    .app_rd_data(app_rd_data[127:0]),
    .led_d_9(led_d_10[1]),
    .IO_ddr_dqs(IO_ddr_dqs[1:0]),
    .IO_ddr_dqs_n(IO_ddr_dqs_n[1:0]),
    .IO_ddr_dq(IO_ddr_dq[15:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DDR3_Memory_Interface_Top */
