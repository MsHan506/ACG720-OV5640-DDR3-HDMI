module gw5at_dvi_pll (
  I_clk_d,
  pll_lock,
  serial_clk
)
;
input I_clk_d;
output pll_lock;
output serial_clk;
wire clkout1_unused;
wire clkout2_unused;
wire clkout3_unused;
wire clkout4_unused;
wire clkout5_unused;
wire clkout6_unused;
wire clkfbout_unused;
wire [7:0] MDRDO;
wire VCC;
wire GND;
  PLLA pll_inst (
    .MDRDO(MDRDO[7:0]),
    .LOCK(pll_lock),
    .CLKOUT0(serial_clk),
    .CLKOUT1(clkout1_unused),
    .CLKOUT2(clkout2_unused),
    .CLKOUT3(clkout3_unused),
    .CLKOUT4(clkout4_unused),
    .CLKOUT5(clkout5_unused),
    .CLKOUT6(clkout6_unused),
    .CLKFBOUT(clkfbout_unused),
    .CLKIN(I_clk_d),
    .CLKFB(GND),
    .RESET(GND),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}),
    .MDCLK(GND),
    .MDOPC({GND,GND}),
    .MDAINC(GND),
