module DVI_TX_Top (
  pix_clk,
  serial_clk,
  I_rst_n_d,
  pll_lock,
  tp0_de_in,
  tp0_vs_in,
  tp0_hs_in,
  tp0_data_r,
  tp0_data_g,
  tp0_data_b,
  O_tmds_clk_p,
  O_tmds_clk_n,
  n36_6,
  O_tmds_data_p,
  O_tmds_data_n
