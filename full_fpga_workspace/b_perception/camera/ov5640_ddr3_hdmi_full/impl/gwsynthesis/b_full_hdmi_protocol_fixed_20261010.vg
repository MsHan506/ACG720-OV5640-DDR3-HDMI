module b_full_top (
  clk50M,
  reset_n,
  motor_start_n,
  motor_stop_n,
  ir_rx,
  tof_uart_rx,
  imu_uart_rx,
  pc_uart_rx,
  pc_uart_tx,
  motor_e1a,
  motor_e1b,
  motor_e2a,
  motor_e2b,
  motor_pwm1,
  motor_ain1,
  motor_ain2,
  motor_pwm2,
  motor_bin1,
  motor_bin2,
  motor_stby,
  camera_sclk,
  camera_sdat,
  camera_vsync,
  camera_href,
  camera_pclk,
  camera_xclk,
  camera_data,
  camera_rst_n,
  camera_pwdn,
  led,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n,
  O_ddr_addr,
  O_ddr_ba,
  O_ddr_cs_n,
  O_ddr_ras_n,
  O_ddr_cas_n,
  O_ddr_we_n,
  O_ddr_clk,
  O_ddr_clk_n,
  O_ddr_cke,
  O_ddr_odt,
  O_ddr_reset_n,
  O_ddr_dqm,
  IO_ddr_dq,
  IO_ddr_dqs,
  IO_ddr_dqs_n
)
;
input clk50M;
input reset_n;
input motor_start_n;
input motor_stop_n;
input ir_rx;
input tof_uart_rx;
input imu_uart_rx;
input pc_uart_rx;
output pc_uart_tx;
input motor_e1a;
input motor_e1b;
input motor_e2a;
input motor_e2b;
output motor_pwm1;
output motor_ain1;
output motor_ain2;
output motor_pwm2;
output motor_bin1;
output motor_bin2;
output motor_stby;
output camera_sclk;
inout camera_sdat;
input camera_vsync;
input camera_href;
input camera_pclk;
