module camera_pll (
  clk50M_d,
  hdmi_pll_lock,
  clk_vgax5,
  camera_xclk_d
)
;
input clk50M_d;
output hdmi_pll_lock;
output clk_vgax5;
output camera_xclk_d;
wire clkout2_unused;
wire clkout3_unused;
wire clkout4_unused;
wire clkout5_unused;
wire clkout6_unused;
wire clkfbout_unused;
wire [7:0] MDRDO;
wire VCC;
wire GND;
  PLLA pll_inst (
    .MDRDO(MDRDO[7:0]),
    .LOCK(hdmi_pll_lock),
    .CLKOUT0(clk_vgax5),
    .CLKOUT1(camera_xclk_d),
    .CLKOUT2(clkout2_unused),
    .CLKOUT3(clkout3_unused),
    .CLKOUT4(clkout4_unused),
    .CLKOUT5(clkout5_unused),
    .CLKOUT6(clkout6_unused),
    .CLKFBOUT(clkfbout_unused),
    .CLKIN(clk50M_d),
    .CLKFB(GND),
    .RESET(GND),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}),
    .MDCLK(GND),
    .MDOPC({GND,GND}),
    .MDAINC(GND),
    .MDWDI({GND,GND,GND,GND,GND,GND,GND,GND}) 
);
defparam pll_inst.CLKFB_SEL="INTERNAL";
defparam pll_inst.CLKOUT0_EN="TRUE";
defparam pll_inst.CLKOUT1_EN="TRUE";
defparam pll_inst.CLKOUT2_EN="FALSE";
defparam pll_inst.CLKOUT3_EN="FALSE";
defparam pll_inst.CLKOUT4_EN="FALSE";
defparam pll_inst.CLKOUT5_EN="FALSE";
defparam pll_inst.CLKOUT6_EN="FALSE";
defparam pll_inst.FBDIV_SEL=1;
defparam pll_inst.FCLKIN="50";
defparam pll_inst.IDIV_SEL=2;
defparam pll_inst.MDIV_FRAC_SEL=1;
defparam pll_inst.MDIV_SEL=37;
defparam pll_inst.ODIV0_FRAC_SEL=4;
defparam pll_inst.ODIV0_SEL=2;
defparam pll_inst.ODIV1_SEL=37;
defparam pll_inst.ODIV2_SEL=8;
defparam pll_inst.ODIV3_SEL=8;
defparam pll_inst.ODIV4_SEL=8;
defparam pll_inst.ODIV5_SEL=8;
defparam pll_inst.ODIV6_SEL=8;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
