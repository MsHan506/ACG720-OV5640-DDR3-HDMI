module sensor_osd_overlay (
  clk50M_d,
  n7_6_3,
  clk_vga,
  rdfifo_rden,
  pitch_cdeg,
  roll_cdeg,
  led_d,
  selected_display_state,
  video_r,
  video_g,
  video_b,
  yaw_cdeg,
  hcount,
  vcount_1,
  vcount_2,
  vcount_4,
  vcount_5,
  vcount_6,
  vcount_7,
  hcount_r,
  vcount_r_0,
  vcount_r_1,
  vcount_r_2,
  vcount_r_3,
  vcount_r_5,
  vcount_r_6,
  vcount_r_7,
  vcount_r_8,
  vcount_r_9,
  front_distance_mm,
  actual_rpm_magnitude,
  motor_e2_rpm,
  actual_rpm_magnitude_13,
  motor_e1_rpm,
  osd_video_de,
  n1181_8,
  n742_10,
  n904_25,
  n1182_13,
  n980_17,
  osd_video_r,
  osd_video_g,
  osd_video_b
)
;
input clk50M_d;
input n7_6_3;
input clk_vga;
input rdfifo_rden;
input [15:0] pitch_cdeg;
input [15:0] roll_cdeg;
input [8:8] led_d;
input [1:0] selected_display_state;
input [7:3] video_r;
input [7:2] video_g;
input [7:3] video_b;
input [15:0] yaw_cdeg;
input [9:1] hcount;
