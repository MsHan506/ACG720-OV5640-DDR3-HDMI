module wr_data_fifo (
  fifo_wrreq,
  app_wdf_end,
  n9_6_3,
  n2023_4,
  ui_clk,
  camera_pclk_d,
  fifo_wrdata,
  wfifo_rcount,
  app_wdf_data
)
;
input fifo_wrreq;
input app_wdf_end;
input n9_6_3;
input n2023_4;
input ui_clk;
input camera_pclk_d;
input [15:0] fifo_wrdata;
output [9:5] wfifo_rcount;
output [127:0] app_wdf_data;
wire VCC;
wire GND;
  \~fifo.wr_data_fifo  fifo_inst (
    .fifo_wrreq(fifo_wrreq),
    .app_wdf_end(app_wdf_end),
    .n9_6_3(n9_6_3),
    .n2023_4(n2023_4),
    .ui_clk(ui_clk),
    .camera_pclk_d(camera_pclk_d),
    .fifo_wrdata(fifo_wrdata[15:0]),
    .wfifo_rcount(wfifo_rcount[9:5]),
    .app_wdf_data(app_wdf_data[127:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* wr_data_fifo */
