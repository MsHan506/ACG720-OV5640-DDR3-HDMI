module DVI_TX_Top (
  pixel_clk,
  serial_clk_x5,
  video_de,
  video_vs,
  video_hs,
  rgb_7,
  rgb_15,
  rgb_23,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n
)
;
input pixel_clk;
input serial_clk_x5;
input video_de;
input video_vs;
input video_hs;
input rgb_7;
input rgb_15;
input rgb_23;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .pixel_clk(pixel_clk),
    .serial_clk_x5(serial_clk_x5),
    .video_de(video_de),
    .video_vs(video_vs),
    .video_hs(video_hs),
    .rgb_7(rgb_7),
    .rgb_15(rgb_15),
    .rgb_23(rgb_23),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
