// ACG720-GW5AT60, GW5AT-LV60PG484AC1/I0
IO_LOC "clk_50m" Y18;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "reset_n" F15;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// GPIO0 bank must be set to 3.3 V before connecting the sensors.
IO_LOC "tof_uart_rx" A13;
IO_PORT "tof_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "imu_uart_rx" A14;
IO_PORT "imu_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// External USB-to-TTL adapter RXD connects to GPIO0_13 / FPGA D15.
IO_LOC "sensor_uart_tx" D15;
IO_PORT "sensor_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// M22 and N22 are dedicated SSPI pins on GW5AT-60B, so use LED2..LED8.
IO_LOC "led[0]" L21;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" K21;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[2]" K22;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[3]" J22;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[4]" H22;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[5]" M21;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[6]" N19;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
