    .imu_angle_valid(imu_angle_valid),
    .initialized(initialized),
    .yaw_cdeg_raw(yaw_cdeg_raw[15:0]),
    .yaw_cdeg(yaw_cdeg[15:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
