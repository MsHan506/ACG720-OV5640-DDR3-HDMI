    .tof_byte(tof_byte[7:0]),
    .tof_measurement_valid(tof_measurement_valid),
    .tof_distance_mm_raw(tof_distance_mm_raw[15:1])
);
  tof_outlier_gate u_tof_gate (
    .clk_50m_d(clk_50m_d),
    .n121_6(n121_6),
    .tof_measurement_valid(tof_measurement_valid),
    .tof_distance_mm_raw(tof_distance_mm_raw[15:1]),
    .tof_gated_valid(tof_gated_valid),
    .tof_gated(tof_gated[15:1])
);
  moving_average4_unsigned u_tof_average (
    .clk_50m_d(clk_50m_d),
    .n121_6(n121_6),
    .tof_gated_valid(tof_gated_valid),
    .tof_gated(tof_gated[15:1]),
    .distance_valid(distance_valid),
    .distance_mm(distance_mm[15:0])
);
  uart_rx_0 u_imu_uart (
    .clk_50m_d(clk_50m_d),
    .n121_6(n121_6),
    .imu_uart_rx_d(imu_uart_rx_d),
    .imu_byte_valid(imu_byte_valid),
